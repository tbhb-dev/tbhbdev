{
  "language": "en",
  "ignorePaths": [
    "**/repo/baseline/{files,kinds,visibility,seed}/**/*",
    "**/lint/gitleaks/{base,upstream}.toml",
    "**/preset.bazelrc",
    "**/uv.lock",
    ".mise/**/*",
    ".rumdl_cache/**/*",
    ".vale/**/*",
    ".venv/**/*",
    ".bazel-*/**/*",
    "bazel-*/**/*",
    "coverage.xml",
    "go.sum",
    "LICENSE",
    "MODULE.bazel.lock",
    "mise.lock",
    "tmp/**/*",
    "**/testdata/**/*",
    "**/*.d2.svg",
    "**/*.d2.sha256",
    "**/pnpm-lock.yaml"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project",
      "path": "./.cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project", "golang", "python"],
  "ignoreRegExpList": ["/\"(?:h1:[A-Za-z0-9+\\/]{43}=|zh:[0-9a-f]{64})\"/g"]
}
