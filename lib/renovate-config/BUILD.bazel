load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = [
    "//factory:__subpackages__",
    "//lib:__subpackages__",
    "//products:__subpackages__",
])

# Globs stop at a package boundary, so this project hands its files to
# //lib:repo_files, which feeds the whole-tree checks in //:repo_files.
filegroup(
    name = "repo_files",
    srcs = glob(["**"]),
    visibility = ["//lib:__pkg__"],
)

# Exercise the inline workflow script with local logs, without Renovate.
sh_test(
    name = "renovate_log_check_test",
    size = "small",
    srcs = ["renovate_log_check_test.sh"],
    data = [
        "renovate_log_check_test.py",
        "//:.github/workflows/renovate.yaml",
    ],
)

# Keep post-upgrade commands and the workflow allowlist in exact agreement.
sh_test(
    name = "renovate_allowlist_test",
    size = "small",
    srcs = ["renovate_allowlist_test.sh"],
    data = glob(["*.json5"]) + [
        "renovate_allowlist_test.py",
        "//:.github/workflows/renovate.yaml",
    ],
)

# Resolve representative updates through the presets' groups and schedules.
sh_test(
    name = "renovate_grouping_test",
    size = "small",
    srcs = ["renovate_grouping_test.sh"],
    data = glob(["*.json5"]) + [
        "renovate_allowlist_test.py",
        "renovate_grouping_test.py",
    ],
)

# Exercise the App-token ruleset audit with local GitHub API fixtures.
sh_test(
    name = "renovate_ruleset_audit_test",
    size = "small",
    srcs = ["renovate_ruleset_audit_test.sh"],
    data = [
        "renovate_ruleset_audit_test.py",
        "//:.github/workflows/renovate.yaml",
    ],
)

# Extract the awrel MCP client pin from inline and multiline JSON args.
sh_test(
    name = "renovate_awrel_pin_test",
    size = "small",
    srcs = ["renovate_awrel_pin_test.sh"],
    data = [
        "default.json5",
        "renovate_allowlist_test.py",
        "renovate_awrel_pin_test.py",
    ],
)
