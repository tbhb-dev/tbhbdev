)

tombi_test(
    name = "tombi_test",
    srcs = [":repo_files"],
    config = "tombi.toml",
    schemas = {
        "https://www.schemastore.org/partial-pytest.json": "@schemastore//:src/schemas/json/partial-pytest.json",
        "https://www.schemastore.org/ruff.json": "@schemastore//:src/schemas/json/ruff.json",
        "https://www.schemastore.org/uv.json": "@schemastore//:src/schemas/json/uv.json",
    },
)

rumdl_test(
    name = "rumdl_test",
    srcs = [":repo_files"],
    config = ".rumdl.toml",
    # The link check's fixtures plant broken links and unused references
    # on purpose, so rumdl's own link rules would fail them. The config
    # stays equal to the parent copy that nested modules carry.
    exclude = [
        ".git",
        "tmp",
        "LICENSE",
        "lint/tests/content/testdata",
        "repo/tests/testdata/markdown_links",
    ],
)

editorconfig_checker_test(
    name = "editorconfig_checker_test",
    srcs = [":repo_files"],
    config = ".editorconfig-checker.json",
)

# The review policy files a repository has; //lint:review_policy_test checks
# them. None exists yet, so OWNERS (which the check ignores) keeps the
# copy non-empty, as tree_check requires, and the glob matches no more until
# the first one lands.
filegroup(
    name = "review_policy_files",
    srcs = ["OWNERS"] + glob(
        [
            ".github/PULL_REQUEST_REVIEW_*.md",
            ".github/pull_request_review.*",
            ".github/schemas/pull-request-review-draft.*",
        ],
        allow_empty = True,
    ),
    visibility = ["//lint:__pkg__"],
)

tree_check_test(
    name = "gitleaks_guard_test",
    srcs = [":repo_files"],
    tool = "//lint:gitleaks_guard",
    tool_args = ["--tree"],
)

