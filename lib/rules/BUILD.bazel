# The lint configs, so the nested modules can prove their own copies match
# (a diff_test against @tbhb_rules//:<config>).
exports_files([
    ".editorconfig",
    ".editorconfig-checker.json",
    ".gitleaks.toml",
    ".rumdl.toml",
    ".ryl.toml",
    "tombi.toml",
])

# Stage monorepo lint configuration in the module-relative tree assembled by
# the lint tests. The source of each file lives at the monorepo root.
_VALE_STYLES = [
    ".vale/config/vocabularies/project/accept.txt",
    ".vale/config/vocabularies/project/reject.txt",
    ".vale/project/Acronyms.yml",
    ".vale/project/CoinedTerms.yml",
    ".vale/project/Colons.yml",
    ".vale/project/HeadingTitleCase.yml",
    ".vale/project/WordList.yml",
]

[
    copy_file(
        name = "stage_" + path.replace("/", "_"),
        src = "@@//:" + path,
        out = path,
        visibility = [
            "//lint/tests:__pkg__",
            "//tools:__pkg__",
        ],
    )
    for path in _VALE_STYLES + [
        ".cspell-words.txt",
        ".cspell.jsonc",
        ".github/schemas/pull-request-draft.schema.json",
        ".gitignore",
        ".vale.ini",
    ]
]

filegroup(
    name = "vale_styles",
    srcs = _VALE_STYLES,
    visibility = ["//tools:__pkg__"],
)

# For //repo/tests:markdown_links_test, which locates the source checkout.
exports_files(
    ["BUILD.bazel"],
    visibility = ["//repo/tests:__pkg__"],
)

exports_files(
    ["pyproject.toml"],
    visibility = [
        "//lint/private/claude_settings:__pkg__",
        "//repo/tests:__pkg__",
        "//tools:__pkg__",
    ],
)

# Every file of the repository, for the whole-tree checks below. Ignored
# directories are listed in REPO.bazel; these are the gitignored files that
# can sit at the root of a working checkout.
# The nested modules (ansible/, astro/, cloudflare/, diagrams/d2/,
# diagrams/structurizr/, go/, playwright/, python/, storybook/, swift/,
# tokens/, typescript/) and the e2e consumers are .bazelignored workspaces of their own, with their own checks.
repo_files(
    exclude = [
        ".DS_Store",
        "**/.DS_Store",
        "IMPORT-MAP.toml",
        ".bazelrc.user",
        ".coverage*",
        ".env*",
        "coverage.*",
        "mise.local.toml",
    ],
    exclude_subpackages = [
        "ansible/**",
        "astro/**",
        "cloudflare/**",
        "diagrams/d2/**",
        "diagrams/structurizr/**",
        "e2e/**",
        "go/**",
        "playwright/**",
        "python/**",
        "storybook/**",
        "swift/**",
        "tokens/**",
        "typescript/**",
    ],
)

# Compare this module's standalone preset to the current generator.
generate_preset(
    name = "preset",
    out = "_preset.bazelrc",
    extra_presets = "{}",
)

# The generator includes the caller's canonical label and Bazel version in
# its comments. Compare the flags so the containing workspace can test the
# preset even when it runs a different Bazel patch release.
genrule(
    name = "preset_flags",
    srcs = [
        ":preset",
        ":preset.bazelrc",
    ],
    outs = [
        "_generated_preset_flags.txt",
        "_source_preset_flags.txt",
    ],
    cmd = """
        grep -v '^#' $(location :preset) > $(location _generated_preset_flags.txt)
        grep -v '^#' $(location :preset.bazelrc) > $(location _source_preset_flags.txt)
    """,
)

diff_test(
    name = "preset.update_test",
    file1 = ":_generated_preset_flags.txt",
    file2 = ":_source_preset_flags.txt",
)

# buildifier: `//:buildifier` formats and applies lint fixes in place,
# `//:buildifier.check` fails on any formatting or lint difference, and the
# test below makes `bazel test //...` fail on the same findings. Every
# available warning is on.
BUILDIFIER_EXCLUDES = [
    "./.git/*",
    "./.venv/*",
    "./.mise/*",
    "./.bazel-*",
    "./bazel-*",
]

buildifier(
    name = "buildifier",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "fix",
    lint_warnings = ["all"],
    mode = "fix",
)

buildifier(
    name = "buildifier.check",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    lint_warnings = ["all"],
    mode = "diff",
)

buildifier_test(
    name = "buildifier_test",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    lint_warnings = ["all"],
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

# This module's own gates, built on its own rules.
gitleaks_history(
    name = "gitleaks_history",
    config = ".gitleaks.toml",
)

gitleaks_test(
    name = "gitleaks_test",
    srcs = [":repo_files"],
    config = ".gitleaks.toml",
)

ryl_test(
    name = "ryl_test",
    srcs = [":repo_files"],
    config = ".ryl.toml",
