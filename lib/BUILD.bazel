load("@tbhb_rules//repo:defs.bzl", "repo_files")

package(default_visibility = [
    "//factory:__subpackages__",
    "//lib:__subpackages__",
    "//products:__subpackages__",
])

package_group(
    name = "consumers",
    packages = [
        "//factory/...",
        "//lib/...",
        "//products/...",
    ],
)

repo_files()

filegroup(
    name = "boundary",
    srcs = ["README.md"],
)
