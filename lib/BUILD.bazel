package(default_visibility = [
    "//factory:__subpackages__",
    "//lib:__subpackages__",
    "//products:__subpackages__",
])

package_group(
    name = "consumers",
    packages = [
        "//factory/...",
        "//lib/...",
        "//products/...",
    ],
)

filegroup(
    name = "repo_files",
    srcs = glob(["**"]) + ["//lib/telemetry:repo_files"],
    visibility = ["//:__pkg__"],
)

filegroup(
    name = "boundary",
    srcs = ["README.md"],
)
