# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf

[*.go]
indent_style = tab

[{*.bzl,BUILD,BUILD.bazel,MODULE.bazel,WORKSPACE,*.bazelrc,.bazelrc}]
indent_style = space
indent_size = 2

[*.{json,jsonc,json5}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2

[*.{sh,sh.tpl}]
indent_style = space
indent_size = 2
shell_variant = bash

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.d2.{svg,png,sha256}]
trim_trailing_whitespace = false

[worker-configuration.d.ts]
trim_trailing_whitespace = false
indent_style = unset

[{structurizr-*.svg,structurizr-*.png,workspace.json}]
trim_trailing_whitespace = false
indent_style = unset

[workspace.json]
insert_final_newline = unset
