load("@bazel_env.bzl", "bazel_env")
load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")
load("@gazelle//:def.bzl", "gazelle", "gazelle_binary", "gazelle_test")
load("@rules_go//go:def.bzl", "nogo")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@tbhb_rules//lint:defs.bzl", "actionlint_test", "gitleaks_history")

exports_files([
    ".gitignore",
    ".go-arch-lint.yml",
    ".golangci.yml",
    ".cspell-words.txt",
    ".cspell.jsonc",
    ".github/actions/affected-targets/action.yml",
    ".github/actions/affected-targets/affected_targets/__init__.py",
    ".github/actions/affected-targets/affected_targets/decide.py",
    ".github/actions/affected-targets/download.sh",
    ".github/actions/affected-targets/select.sh",
    ".github/actions/setup-bazel-ci/cpu_quota.sh",
    ".github/actions/setup-bazel-ci/fetch-targets.txt",
    ".github/actions/setup-bazel-ci/fetch.sh",
    ".github/prose-lint.sh",
    ".github/schemas/pull-request-draft.schema.json",
    ".github/workflows/ci.yml",
    ".github/workflows/mutation-nightly.yml",
    ".pre-commit-config.yaml",
    ".vale.ini",
    ".vale/config/vocabularies/project/accept.txt",
    ".vale/config/vocabularies/project/reject.txt",
    ".vale/project/Acronyms.yml",
    ".vale/project/CoinedTerms.yml",
    ".vale/project/Colons.yml",
    ".vale/project/HeadingTitleCase.yml",
    ".vale/project/WordList.yml",
    "mise.toml",
    "tombi.toml",
])

exports_files(
    ["uv.lock"],
    visibility = ["//factory/cli:__pkg__"],
)

exports_files(
    [
        ".github/workflows/renovate.yaml",
        "renovate.json5",
    ],
    visibility = ["//lib/renovate-config:__pkg__"],
)

# gazelle:python_extension disabled

py_binary(
    name = "preflight",
    srcs = ["@tbhb_rules//lint:preflight/preflight.py"],
    legacy_create_init = False,
    main = "@tbhb_rules//lint:preflight/preflight.py",
)

gazelle_binary(
    name = "gazelle_bin",
    languages = [
        "@gazelle//language/proto",
        "@gazelle//language/go",
        "@rules_python_gazelle_plugin//python",
    ],
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_bin",
)

gazelle(
    name = "gazelle.check",
    gazelle = ":gazelle_bin",
    mode = "diff",
)

gazelle_test(
    name = "gazelle_test",
    size = "small",
    gazelle = ":gazelle_bin",
    workspace = "//:MODULE.bazel",
)

nogo(
    name = "nogo",
    vet = True,
    visibility = ["//visibility:public"],
)

# Installs the Vale packages pinned in .vale.ini.
sh_binary(
    name = "vale_sync",
    srcs = ["vale_sync.sh"],
    args = ["$(rootpath @tbhb_rules_vale//:vale)"],
    data = ["@tbhb_rules_vale//:vale"],
)

BUILDIFIER_EXCLUDES = [
    "./.git/*",
    "./.venv/*",
    "./.mise/*",
    "./bazel-*",
    "./.bazel-*",
    "./.worktrees/*",
    "./lib/rules/*",
    "./tmp/*",
]

buildifier(
    name = "buildifier",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "fix",
    lint_warnings = ["all"],
    mode = "fix",
)

buildifier_test(
    name = "buildifier_test",
    size = "small",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    lint_warnings = ["all"],
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

actionlint_test(
    name = "actionlint_test",
    srcs = glob([
        ".github/actions/**",
        ".github/workflows/**",
    ]),
    config = ".github/actionlint.yaml",
)

gitleaks_history(
    name = "gitleaks_history",
    config = ".gitleaks.toml",
)

# Repository filegroup consumed by //factory:visibility_test.
filegroup(
    name = "repo_files",
    srcs = glob(
        [
            "**",
            "**/.*",
        ],
        allow_empty = True,
        exclude = [
            "**/.DS_Store",
            # Gitignored packages downloaded by vale_sync.
            ".vale/Google/**",
            ".vale/ai-tells/**",
            ".vale/ai-tells-experimental/**",
            ".vale/proselint/**",
            ".vale/write-good/**",
            ".bazel-*",
            ".bazelrc.user",
            ".claude/settings.local.json",
            ".coverage*",
            ".env*",
            ".git/**",
            ".github/PULL_REQUEST_DRAFT.md",
            ".mise/**",
            ".mutation/**",
            ".venv/**",
            ".worktrees/**",
            "bazel-*",
            "coverage.*",
            "mise.local.toml",
            "tmp/**",
        ],
    ) + [
        "//factory:repo_files",
        "//lib:repo_files",
    ],
    visibility = ["//factory:__subpackages__"],
)

# Shared inputs for the CLI's hermetic Python checks.
filegroup(
    name = "cli_check_inputs",
    srcs = glob([
        ".vale/config/**",
        ".vale/project/**",
    ]) + [
        ".cspell.jsonc",
        ".cspell-words.txt",
        ".gitattributes",
        ".github/PULL_REQUEST_TEMPLATE.md",
        ".github/pull-request-sections.toml",
        ".github/schemas/pull-request-draft.schema.json",
        ".github/workflows/ci.yml",
        ".gitleaks.toml",
        ".rumdl.toml",
        ".vale.ini",
        "pyproject.toml",
        "uv.lock",
    ],
    visibility = ["//factory/cli:__subpackages__"],
)

bazel_env(
    name = "bazel_env",
    tools = {
        "actionlint": "@tbhb_rules_actionlint//:actionlint",
        "buildifier": "@buildifier_prebuilt//:buildifier",
        "cog": "@tbhb_rules_cog//:cog",
        "editorconfig-checker": "@tbhb_rules_editorconfig_checker//:editorconfig-checker",
        "gitleaks": "@tbhb_rules//lint:gitleaks",
        "gitleaks-raw": "@tbhb_rules_gitleaks//:gitleaks",
        "rumdl": "@tbhb_rules_rumdl//:rumdl",
        "ryl": "@tbhb_rules_ryl//:ryl",
        "scc": "@tbhb_rules_scc//:scc",
        "shellcheck": "@tbhb_rules_shellcheck//:shellcheck",
        "shfmt": "@tbhb_rules_shfmt//:shfmt",
        "tombi": "@tbhb_rules_tombi//:tombi",
        "vale": "@tbhb_rules_vale//:vale",
        "zizmor": "@tbhb_rules_zizmor//:zizmor",
    },
)
