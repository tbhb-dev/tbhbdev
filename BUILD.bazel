load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")
load("@gazelle//:def.bzl", "gazelle", "gazelle_test")
load("@rules_go//go:def.bzl", "nogo")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@tbhb_rules//lint:defs.bzl", "actionlint_test", "gitleaks_history")

exports_files([
    ".gitignore",
    ".go-arch-lint.yml",
    ".golangci.yml",
    ".cspell-words.txt",
    ".cspell.jsonc",
    ".github/actions/affected-targets/action.yml",
    ".github/actions/affected-targets/select.sh",
    ".github/actions/setup-bazel-ci/cpu_quota.sh",
    ".github/actions/setup-bazel-ci/fetch-targets.txt",
    ".github/actions/setup-bazel-ci/fetch.sh",
    ".github/schemas/pull-request-draft.schema.json",
    ".github/workflows/mutation-nightly.yml",
    ".vale.ini",
    ".vale/config/vocabularies/project/accept.txt",
    ".vale/config/vocabularies/project/reject.txt",
    ".vale/project/Acronyms.yml",
    ".vale/project/CoinedTerms.yml",
    ".vale/project/Colons.yml",
    ".vale/project/HeadingTitleCase.yml",
    ".vale/project/WordList.yml",
    "go.mod",
])

# Gazelle reads the monorepo go.mod.
gazelle(name = "gazelle")

gazelle(
    name = "gazelle.check",
    mode = "diff",
)

gazelle_test(
    name = "gazelle_test",
    size = "small",
    workspace = "//:MODULE.bazel",
)

nogo(
    name = "nogo",
    vet = True,
    visibility = ["//visibility:public"],
)

# Installs the Vale packages pinned in .vale.ini; uses `vale` from PATH.
sh_binary(
    name = "vale_sync",
    srcs = ["vale_sync.sh"],
)

BUILDIFIER_EXCLUDES = [
    "./.git/*",
    "./.venv/*",
    "./.mise/*",
    "./bazel-*",
    "./.bazel-*",
    "./.worktrees/*",
    "./lib/rules/*",
    "./tmp/*",
]

buildifier(
    name = "buildifier",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "fix",
    lint_warnings = ["all"],
    mode = "fix",
)

buildifier_test(
    name = "buildifier_test",
    size = "small",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    lint_warnings = ["all"],
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

actionlint_test(
    name = "actionlint_test",
    srcs = glob([
        ".github/actions/**",
        ".github/workflows/**",
    ]),
    config = ".github/actionlint.yaml",
)

gitleaks_history(
    name = "gitleaks_history",
    config = ".gitleaks.toml",
)

# Repository filegroup consumed by //factory:visibility_test.
filegroup(
    name = "repo_files",
    srcs = glob(
        [
            "**",
            "**/.*",
        ],
        allow_empty = True,
        exclude = [
            "**/.DS_Store",
            # Gitignored packages downloaded by vale_sync.
            ".vale/Google/**",
            ".vale/ai-tells/**",
            ".vale/ai-tells-experimental/**",
            ".vale/proselint/**",
            ".vale/write-good/**",
            ".bazel-*",
            ".bazelrc.user",
            ".claude/settings.local.json",
            ".coverage*",
            ".env*",
            ".git/**",
            ".github/PULL_REQUEST_DRAFT.md",
            ".mise/**",
            ".mutation/**",
            ".venv/**",
            ".worktrees/**",
            "bazel-*",
            "coverage.*",
            "mise.local.toml",
            "tmp/**",
        ],
    ) + [
        "//factory:repo_files",
        "//lib:repo_files",
    ],
    visibility = ["//factory:__subpackages__"],
)
