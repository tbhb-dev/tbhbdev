"""Root Bazel module for the tbhbdev monorepo."""

module(name = "tbhbdev")

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
)

bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_lib", version = "3.7.0")
bazel_dep(name = "bazel_env.bzl", version = "0.10.0")
bazel_dep(name = "bazelrc-preset.bzl", version = "1.10.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_testing", version = "0.9.0")
bazel_dep(name = "rules_python", version = "2.5.1")
bazel_dep(name = "rules_python_gazelle_plugin", version = "2.5.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")
go_sdk.nogo(
    includes = ["//:__subpackages__"],
    nogo = "//:nogo",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "io_etcd_go_bbolt",
    "io_opentelemetry_go_otel",
    "io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetrichttp",
    "io_opentelemetry_go_otel_metric",
    "io_opentelemetry_go_otel_sdk",
    "io_opentelemetry_go_otel_sdk_metric",
    "io_opentelemetry_go_proto_otlp",
    "org_golang_google_protobuf",
)

go_mod_proxy = use_extension("@tbhb_rules_go//:extensions.bzl", "go_mod_proxy")
go_mod_proxy.from_file(
    name = "go_mod_proxy",
    go_sum = "//:go.sum",
)
use_repo(go_mod_proxy, "go_mod_proxy")

python_toolchains = use_extension("@rules_python//python/extensions:python.bzl", "python")
python_toolchains.toolchain(python_version = "3.15")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "cli_pip",
    python_version = "3.15",
    uv_lock = "//:uv.lock",
)
use_repo(pip, "cli_pip")

python = use_extension("@tbhb_rules_python//:extensions.bzl", "python")
python.project()

bazel_dep(name = "tbhb_rules", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules",
    path = "lib/rules",
)

bazel_dep(name = "tbhb_rules_ansible", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_ansible",
    path = "lib/rules/ansible",
)

bazel_dep(name = "tbhb_rules_python", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_python",
    path = "lib/rules/python",
)

bazel_dep(name = "tbhb_rules_astro", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_astro",
    path = "lib/rules/astro",
)

bazel_dep(name = "tbhb_rules_cloudflare", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_cloudflare",
    path = "lib/rules/cloudflare",
)

bazel_dep(name = "tbhb_rules_d2", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_d2",
    path = "lib/rules/diagrams/d2",
)

bazel_dep(name = "tbhb_rules_structurizr", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_structurizr",
    path = "lib/rules/diagrams/structurizr",
)

bazel_dep(name = "tbhb_rules_go", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_go",
    path = "lib/rules/go",
)

bazel_dep(name = "tbhb_rules_playwright", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_playwright",
    path = "lib/rules/playwright",
)

bazel_dep(name = "tbhb_rules_storybook", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_storybook",
    path = "lib/rules/storybook",
)

bazel_dep(name = "tbhb_rules_swift", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_swift",
    path = "lib/rules/swift",
)

bazel_dep(name = "tbhb_rules_tokens", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_tokens",
    path = "lib/rules/tokens",
)

bazel_dep(name = "tbhb_rules_typescript", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_typescript",
    path = "lib/rules/typescript",
)

# The tool binaries @tbhb_rules pins, so the bazel_env shims and CI name
# the same repositories and each tool keeps one pin.
tools = use_extension("@tbhb_rules//pins:extensions.bzl", "tools")
use_repo(
    tools,
    "tbhb_rules_actionlint",
    "tbhb_rules_cog",
    "tbhb_rules_editorconfig_checker",
    "tbhb_rules_gitleaks",
    "tbhb_rules_rumdl",
    "tbhb_rules_ryl",
    "tbhb_rules_scc",
    "tbhb_rules_shellcheck",
    "tbhb_rules_shfmt",
    "tbhb_rules_tombi",
    "tbhb_rules_vale",
    "tbhb_rules_zizmor",
)

# Pinned copies of the SchemaStore schemas that pyproject.toml's embedded
# tombi schema refers to by URL, so //factory/cli:tombi_test validates offline. Pinned
# to a SchemaStore commit, because www.schemastore.org serves whatever is
# current and its digests drift.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

cue_test_tool = use_repo_rule("//factory/cli/tests:cue_test_tool.bzl", "cue_test_tool")

cue_test_tool(
    name = "cue_test_tool",
    dev_dependency = True,
)

_SCHEMASTORE = "https://raw.githubusercontent.com/SchemaStore/schemastore/f0e072bb85076fcae82bebf058cf86520d4ea450/src/schemas/json/"

http_file(
    name = "schemastore_uv",
    dev_dependency = True,
    sha256 = "accd72042015703861297d12c682e0d9c35f435506acf942874927bb367ccdf7",
    url = _SCHEMASTORE + "uv.json",
)

http_file(
    name = "schemastore_partial_pytest",
    dev_dependency = True,
    sha256 = "15894b3b37e0ae60b79869da43b9e26790bc1198d645586ca8447246c23f9ac4",
    url = _SCHEMASTORE + "partial-pytest.json",
)

http_file(
    name = "schemastore_ruff",
    dev_dependency = True,
    sha256 = "d543216c52a7bd33325de767ebba8b410162302bce2cdc8980662e0bc06984be",
    url = _SCHEMASTORE + "ruff.json",
)
