"""Root Bazel module for the tbhbdev monorepo."""

module(name = "tbhbdev")

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
)

bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_env.bzl", version = "0.10.0")
bazel_dep(name = "bazelrc-preset.bzl", version = "1.10.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_testing", version = "0.9.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")
go_sdk.nogo(
    includes = ["//:__subpackages__"],
    nogo = "//:nogo",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

python_toolchains = use_extension("@rules_python//python/extensions:python.bzl", "python")
python_toolchains.toolchain(python_version = "3.15")

python = use_extension("@tbhb_rules_python//:extensions.bzl", "python")
python.project()

bazel_dep(name = "tbhb_rules", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules",
    path = "lib/rules",
)

bazel_dep(name = "tbhb_rules_ansible", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_ansible",
    path = "lib/rules/ansible",
)

bazel_dep(name = "tbhb_rules_python", version = "0.0.0")
local_path_override(
    module_name = "tbhb_rules_python",
    path = "lib/rules/python",
)
