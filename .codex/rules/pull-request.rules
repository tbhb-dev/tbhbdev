# Build for actual callers. Omit handling for cases that cannot occur here
# and options, layers, or abstractions with one user. Record doubt about
# whether a case can occur under Decisions in the pull request body.

# Agents open, edit and merge pull requests through `tbhbdev alpha pr` and
# `tbhbdev alpha merge`, never with gh directly. The commands call gh
# themselves; these rules only see commands the agent types. They back up
# `tbhbdev alpha guard-gh-pr`, the PreToolUse hook that blocks the same calls
# and hints at the right command; the rule catches what the hook misses.
prefix_rule(
    pattern = ["gh", "pr", ["create", "edit", "merge"]],
    decision = "forbidden",
    justification = "Blocked: do not run gh pr create|edit|merge. Write .github/PULL_REQUEST_DRAFT.md, then `tbhbdev alpha pr check` and `tbhbdev alpha pr create`, or `tbhbdev alpha pr edit .github/PULL_REQUEST_DRAFT.md --pr N` to update; `tbhbdev alpha merge N` merges an approved PR.",
)
