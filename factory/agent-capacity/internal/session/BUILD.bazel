load("@rules_go//go:def.bzl", "go_library")
load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("//factory:go.bzl", "go_test")

repo_files(visibility = ["//factory/agent-capacity:__pkg__"])

go_library(
    name = "session",
    srcs = [
        "account.go",
        "process.go",
        "runner.go",
        "settings.go",
        "starttime_darwin.go",
        "starttime_linux.go",
    ],
    importpath = "github.com/tbhb-dev/tbhbdev/factory/agent-capacity/internal/session",
    visibility = ["//factory/agent-capacity:__subpackages__"],
    deps = [
        "//factory/agent-capacity/internal/capacity",
        "//factory/agent-capacity/internal/spool",
        "@com_github_creack_pty//:pty",
    ] + select({
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "session_test",
    srcs = [
        "lifecycle_test.go",
        "session_test.go",
        "starttime_darwin_test.go",
        "starttime_linux_test.go",
    ],
    embed = [":session"],
    visibility = ["//factory/agent-capacity:__pkg__"],
    deps = [
        "//factory/agent-capacity/internal/spool",
        "@com_github_creack_pty//:pty",
    ],
)
