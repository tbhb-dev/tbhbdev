load("@rules_go//go:def.bzl", "go_library")
load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("//factory:go.bzl", "go_test")

repo_files(visibility = ["//factory/agent-capacity:__pkg__"])

exports_files(
    ["testdata/stops.json"],
    visibility = ["//factory/agent-capacity:__pkg__"],
)

go_library(
    name = "keepalive",
    srcs = [
        "decision.go",
        "keepalive.go",
        "store.go",
    ],
    importpath = "github.com/tbhb-dev/tbhbdev/factory/agent-capacity/internal/keepalive",
    visibility = ["//factory/agent-capacity:__subpackages__"],
)

go_test(
    name = "keepalive_test",
    srcs = [
        "decision_test.go",
        "keepalive_test.go",
        "store_test.go",
        "store_unix_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":keepalive"],
    visibility = ["//factory/agent-capacity:__pkg__"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
