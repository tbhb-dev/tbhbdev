        "parked.go",
        "parked_socket.go",
        "parked_socket_other.go",
        "read.go",
        "read_tokens.go",
        "runner.go",
        "serve.go",
        "session.go",
        "store.go",
        "targets.go",
        "telemetry.go",
    ],
    importpath = "github.com/tbhb-dev/tbhbdev/factory/event-gateway/cmd/event-gateway",
    visibility = ["//visibility:private"],
    deps = [
        "//factory/event-gateway/internal/eventfields",
        "//factory/event-gateway/internal/filter",
        "//factory/event-gateway/internal/routing",
        "//factory/event-gateway/internal/temporaltarget",
