load("//factory/cli/tests:pytest.bzl", "cli_py_test")

filegroup(
    name = "package_files",
    srcs = glob(["*.py"]),
    visibility = ["//factory/cli/tests:__pkg__"],
)

cli_py_test(
    name = "test_home",
    srcs = ["test_home.py"],
    imports = ["../../../.."],
    deps = [
        "//factory/cli/src/tbhbdev/alpha/agent/bundle:home",
        "//factory/cli/tests:conftest",
        "@cli_pip//pytest",
    ],
)

cli_py_test(
    name = "test_run",
    srcs = ["test_run.py"],
    imports = ["../../../.."],
    deps = [
        "//factory/cli/src/tbhbdev:__init__",
        "//factory/cli/src/tbhbdev:version",
        "//factory/cli/src/tbhbdev/alpha/agent:runfiles",
        "//factory/cli/src/tbhbdev/alpha/agent/bundle:run",
        "//factory/cli/tests:conftest",
        "@cli_pip//pytest",
    ],
)
