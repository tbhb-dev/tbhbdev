load("//factory/cli/tests:pytest.bzl", "cli_py_test")

filegroup(
    name = "package_files",
    srcs = glob(["*.py"]),
    visibility = ["//factory/cli/tests:__pkg__"],
)

genrule(
    name = "rules_tool_pins",
    testonly = True,
    srcs = ["@tbhb_rules//pins:tools.json"],
    outs = ["rules-tool-pins.json"],
    cmd = "cp $< $@",
)

