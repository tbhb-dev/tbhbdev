load("//factory/cli/tests:pytest.bzl", "cli_py_test")

filegroup(
    name = "package_files",
    srcs = glob(["*.py"]),
    visibility = ["//factory/cli/tests:__pkg__"],
)

cli_py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    imports = ["../.."],
    deps = [
        "//factory/cli/src/tbhbdev:host_executables",
        "//factory/cli/src/tbhbdev:host_tokens",
        "//factory/cli/src/tbhbdev/secrets:config",
        "//factory/cli/src/tbhbdev/secrets:connect",
        "//factory/cli/tests:conftest",
        "//factory/cli/tests:stub_fixtures",
        "@cli_pip//pytest",
    ],
)

cli_py_test(
    name = "test_connect",
    srcs = ["test_connect.py"],
    imports = ["../.."],
    deps = [
        "//factory/cli/src/tbhbdev/secrets:connect",
        "//factory/cli/src/tbhbdev/secrets:store",
        "//factory/cli/tests:conftest",
        "@cli_pip//httpx",
        "@cli_pip//onepasswordconnectsdk",
        "@cli_pip//pytest",
    ],
)

cli_py_test(
    name = "test_store",
    srcs = ["test_store.py"],
    imports = ["../.."],
    deps = [
        "//factory/cli/src/tbhbdev/alpha/agent:credentials",
        "//factory/cli/src/tbhbdev/secrets:config",
        "//factory/cli/src/tbhbdev/secrets:connect",
        "//factory/cli/src/tbhbdev/secrets:store",
        "//factory/cli/tests:agent_host_example",
        "//factory/cli/tests:conftest",
        "@cli_pip//cryptography",
        "@cli_pip//pytest",
