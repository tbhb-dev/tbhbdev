load("//factory/cli/tests:pytest.bzl", "cli_py_test")

package(default_testonly = True)

filegroup(
    name = "package_files",
    testonly = False,
    srcs = glob(["*.py"]),
    visibility = ["//factory/cli/tests:__pkg__"],
)

cli_py_test(
    name = "test_monorepo",
    srcs = ["test_monorepo.py"],
    imports = ["../.."],
    deps = [
        "//factory/cli/src/tbhbdev/monorepo:command",
        "//factory/cli/src/tbhbdev/monorepo:pathmap",
        "//factory/cli/src/tbhbdev/monorepo:source",
        "//factory/cli/tests:conftest",
        "@cli_pip//pytest",
    ],
)
