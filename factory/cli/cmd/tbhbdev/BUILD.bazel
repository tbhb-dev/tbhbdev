load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//factory:go.bzl", "go_test")
load("//factory:go_lint.bzl", "golangci_lint_test")

# gazelle:map_kind go_test go_test //factory:go.bzl

go_library(
    name = "tbhbdev_lib",
    srcs = ["main.go"],
    importpath = "github.com/tbhb-dev/tbhbdev/factory/cli/cmd/tbhbdev",
    visibility = ["//visibility:private"],
    deps = ["//factory/cli/internal/dispatch"],
)

go_binary(
    name = "tbhbdev",
    embed = [":tbhbdev_lib"],
    visibility = ["//visibility:private"],
)

go_test(
    name = "tbhbdev_test",
    srcs = ["main_test.go"],
    embed = [":tbhbdev_lib"],
    visibility = ["//factory/github-metrics:__pkg__"],
)

golangci_lint_test(
    name = "golangci_lint_test",
    size = "small",
    srcs = [
        ":tbhbdev_test",
        "//factory/cli/internal/dispatch:dispatch_test",
    ],
)

test_suite(
    name = "go_arch_lint_test",
    tests = ["//factory/github-metrics:go_arch_lint_test"],
)

filegroup(
    name = "go_module_sources",
    srcs = glob(["*.go"]),
    visibility = ["//factory/github-metrics:__pkg__"],
)
