load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//factory:go.bzl", "go_test", "golangci_lint_test")

# gazelle:map_kind go_test go_test //factory:go.bzl

filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//:__pkg__"],
)

go_library(
    name = "tbhbdev_lib",
    srcs = ["main.go"],
    importpath = "github.com/tbhb-dev/tbhbdev/factory/cli/cmd/tbhbdev",
    visibility = ["//visibility:private"],
    deps = ["//factory/cli/internal/dispatch"],
)

go_binary(
    name = "tbhbdev",
    embed = [":tbhbdev_lib"],
    visibility = ["//visibility:private"],
)

go_test(
    name = "tbhbdev_test",
    srcs = ["main_test.go"],
    embed = [":tbhbdev_lib"],
    visibility = ["//factory/event-gateway:__pkg__"],
)

golangci_lint_test(
    name = "golangci_lint_test",
    size = "small",
    srcs = [
        ":tbhbdev_test",
        "//factory/cli/internal/dispatch:dispatch_test",
    ],
)

# The root Go module has one set of import contracts with entries for both projects.
test_suite(
    name = "go_arch_lint_test",
    tests = ["//factory/event-gateway:go_arch_lint_test"],
)
