load("//factory/cli:python.bzl", "cli_py_library")

cli_py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "pathmap",
    srcs = ["pathmap.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":source",
        "@cli_pip//tomlkit",
    ],
)

cli_py_library(
    name = "source",
    srcs = ["source.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "verify",
    srcs = ["verify.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":pathmap",
        ":source",
    ],
)

filegroup(
    name = "package_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//factory/cli:__pkg__"],
)

cli_py_library(
    name = "command",
    srcs = ["command.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":pathmap",
        ":source",
        ":verify",
        "//factory/cli/src/tbhbdev/alpha:terminal",
    ],
)
