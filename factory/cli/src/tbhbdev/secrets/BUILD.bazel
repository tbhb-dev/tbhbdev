load("//factory/cli:python.bzl", "cli_py_library")

filegroup(
    name = "package_files",
    srcs = glob(["*.py"]),
    visibility = ["//factory/cli:__pkg__"],
)

cli_py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "config",
    srcs = ["config.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":connect",
        "//factory/cli/src/tbhbdev:userconfig",
        "//factory/cli/src/tbhbdev/alpha/agent:host_tools",
        "//factory/cli/src/tbhbdev/alpha/agent:model",
    ],
)

cli_py_library(
    name = "connect",
    srcs = ["connect.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        "@cli_pip//httpx",
        "@cli_pip//httpx2",
        "@cli_pip//onepasswordconnectsdk",
    ],
)

cli_py_library(
    name = "store",
    srcs = ["store.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":config",
        ":connect",
        "@cli_pip//cryptography",
        "@cli_pip//httpx",
        "@cli_pip//httpx2",
        "@cli_pip//onepasswordconnectsdk",
    ],
)
