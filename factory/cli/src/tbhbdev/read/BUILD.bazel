load("//factory/cli:python.bzl", "cli_py_library")

filegroup(
    name = "package_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//factory/cli:__pkg__"],
)

cli_py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "github",
    srcs = ["github.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        "//factory/cli/src/tbhbdev:github_tls",
        "//factory/cli/src/tbhbdev:userconfig",
        "//factory/cli/src/tbhbdev/alpha:gh_shim",
        "@cli_pip//httpx2",
    ],
)

cli_py_library(
    name = "pr_state",
    srcs = ["pr_state.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
)
