load("//factory/cli:python.bzl", "cli_py_library")

filegroup(
    name = "package_files",
    srcs = glob(["*.py"]),
    visibility = ["//factory/cli:__pkg__"],
)

cli_py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = ["../../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "command",
    srcs = ["command.py"],
    imports = ["../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        "//factory/cli/src/tbhbdev:userconfig",
        "//factory/cli/src/tbhbdev:version",
        "//factory/cli/src/tbhbdev/alpha:command",
        "//factory/cli/src/tbhbdev/alpha:tool_pins",
        "//factory/cli/src/tbhbdev/alpha/agent:host_tools",
        "//factory/cli/src/tbhbdev/alpha/agent:model",
        "//factory/cli/src/tbhbdev/alpha/agent:settings",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:limits",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:remote_host",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:repo",
    ],
)
