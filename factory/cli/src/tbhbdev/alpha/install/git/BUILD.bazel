filegroup(
    name = "package_files",
    srcs = glob(["*.py"]),
    visibility = ["//factory/cli/src/tbhbdev/alpha/install:__pkg__"],
)

cli_py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "hooks",
    srcs = ["hooks.py"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":lock",
        ":prek",
        ":shims",
        "//factory/cli/src/tbhbdev/alpha:gh_shim",
        "//factory/cli/src/tbhbdev/alpha:repo",
        "//factory/cli/src/tbhbdev/alpha/install:model",
        "//factory/cli/src/tbhbdev/alpha/install:scripts",
    ],
)

cli_py_library(
    name = "lock",
    srcs = ["lock.py"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = ["//factory/cli/src/tbhbdev/alpha/install:model"],
)

cli_py_library(
    name = "prek",
    srcs = ["prek.py"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = ["//factory/cli/src/tbhbdev/alpha/install:model"],
)

cli_py_library(
    name = "shims",
    srcs = ["shims.py"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":prek",
        "//factory/cli/src/tbhbdev/alpha:gh_shim",
        "//factory/cli/src/tbhbdev/alpha:repo",
        "//factory/cli/src/tbhbdev/alpha/identity/commit:policy",
        "//factory/cli/src/tbhbdev/alpha/install:files",
        "//factory/cli/src/tbhbdev/alpha/install:model",
        "//factory/cli/src/tbhbdev/alpha/install:scripts",
    ],
)
