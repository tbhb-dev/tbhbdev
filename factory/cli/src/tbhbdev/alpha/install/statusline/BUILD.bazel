load("//factory/cli:python.bzl", "cli_py_library")

# SPDX-License-Identifier: Apache-2.0
# Copyright Tony Burns

filegroup(
    name = "package_files",
    srcs = glob(["*.py"]),
    visibility = ["//factory/cli/src/tbhbdev/alpha/install:__pkg__"],
)

cli_py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "command",
    srcs = ["command.py"],
    imports = ["../../../.."],
    pyi_deps = ["//factory/cli/src/tbhbdev/alpha/install:model"],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "pin",
    srcs = ["pin.py"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":command",
        "//factory/cli/src/tbhbdev/alpha/install:files",
        "//factory/cli/src/tbhbdev/alpha/install:model",
        "//factory/cli/src/tbhbdev/alpha/install:settings",
    ],
)
