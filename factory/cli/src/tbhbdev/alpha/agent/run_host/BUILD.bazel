load("//factory/cli:python.bzl", "cli_py_library")

filegroup(
    name = "package_files",
    srcs = glob(["*.py"]),
    visibility = ["//factory/cli/src/tbhbdev/alpha/agent:__pkg__"],
)

cli_py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "dispatcher",
    srcs = ["dispatcher.py"],
    extra_deps = [":__init__"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":plan",
        ":telemetry",
        "//factory/cli/src/tbhbdev:userconfig",
        "//factory/cli/src/tbhbdev/alpha:codex_trust",
        "//factory/cli/src/tbhbdev/alpha:identity",
        "//factory/cli/src/tbhbdev/alpha:install",
        "//factory/cli/src/tbhbdev/alpha:run_stop_hook",
        "//factory/cli/src/tbhbdev/alpha/agent:admission",
        "//factory/cli/src/tbhbdev/alpha/agent:bazel_servers",
        "//factory/cli/src/tbhbdev/alpha/agent:build_info",
        "//factory/cli/src/tbhbdev/alpha/agent:codex_install",
        "//factory/cli/src/tbhbdev/alpha/agent:credentials",
        "//factory/cli/src/tbhbdev/alpha/agent:host_tools",
        "//factory/cli/src/tbhbdev/alpha/agent:model",
        "//factory/cli/src/tbhbdev/alpha/agent:ownership",
        "//factory/cli/src/tbhbdev/alpha/agent:process_group",
        "//factory/cli/src/tbhbdev/alpha/agent:push",
        "//factory/cli/src/tbhbdev/alpha/agent:render",
        "//factory/cli/src/tbhbdev/alpha/agent:review_post",
        "//factory/cli/src/tbhbdev/alpha/agent:runfiles",
        "//factory/cli/src/tbhbdev/alpha/agent:settings",
        "//factory/cli/src/tbhbdev/alpha/agent:shims",
        "//factory/cli/src/tbhbdev/alpha/agent:worktree",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:argv",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:policy",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:repo",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:request",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:run_state",
        "@cli_pip//httpx",
    ],
)

cli_py_library(
    name = "telemetry",
    srcs = ["telemetry.py"],
    extra_deps = [":__init__"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "plan",
    srcs = ["plan.py"],
    extra_deps = [":__init__"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        "//factory/cli/src/tbhbdev/alpha/agent:model",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:config",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:request",
    ],
)
