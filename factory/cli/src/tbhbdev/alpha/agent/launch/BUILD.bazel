load("//factory/cli:python.bzl", "cli_py_library")

filegroup(
    name = "package_files",
    srcs = glob(["*.py"]),
    visibility = ["//factory/cli:__pkg__"],
)

cli_py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "command",
    srcs = ["command.py"],
    extra_deps = [":__init__"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = ["//factory/cli/src/tbhbdev/alpha/agent:model"],
)

cli_py_library(
    name = "ship",
    srcs = ["ship.py"],
    extra_deps = [":__init__"],
    imports = ["../../../.."],
    pyi_deps = [
        "//factory/cli/src/tbhbdev/alpha/agent/driver/decisions:metadata",
        "//factory/cli/src/tbhbdev/alpha/agent:transport",
    ],
    visibility = ["//factory/cli:__subpackages__"],
    deps = ["//factory/cli/src/tbhbdev/alpha/agent:model"],
)
