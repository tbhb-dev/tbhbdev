load("//factory/cli:python.bzl", "cli_py_library")

filegroup(
    name = "package_files",
    srcs = glob(["*.py"]),
    visibility = ["//factory/cli:__pkg__"],
)

cli_py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "command",
    srcs = ["command.py"],
    extra_deps = [":__init__"],
    imports = ["../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":ship",
        "//factory/cli/src/tbhbdev:userconfig",
        "//factory/cli/src/tbhbdev/alpha:worker_identity",
        "//factory/cli/src/tbhbdev/alpha/agent:cli_bundle",
        "//factory/cli/src/tbhbdev/alpha/agent:model",
        "//factory/cli/src/tbhbdev/alpha/agent:settings",
        "//factory/cli/src/tbhbdev/alpha/agent:transport",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:request",
        "//factory/cli/src/tbhbdev/alpha/agent/driver:arguments",
        "//factory/cli/src/tbhbdev/alpha/agent/driver:launch",
        "//factory/cli/src/tbhbdev/alpha/agent/driver:metadata",
        "//factory/cli/src/tbhbdev/alpha/agent/driver:reviews",
        "//factory/cli/src/tbhbdev/alpha/agent/driver:startup",
        "//factory/cli/src/tbhbdev/alpha/agent/driver/decisions:launch",
        "//factory/cli/src/tbhbdev/alpha/agent/driver/decisions:output",
        "//factory/cli/src/tbhbdev/alpha/agent/driver/decisions:prompt",
        "//factory/cli/src/tbhbdev/alpha/agent/launch/decisions:bootstrap",
    ],
)

cli_py_library(
    name = "ship",
    srcs = ["ship.py"],
    extra_deps = [":__init__"],
    imports = ["../../../.."],
    pyi_deps = ["//factory/cli/src/tbhbdev/alpha/agent/driver/decisions:metadata"],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        "//factory/cli/src/tbhbdev/alpha/agent:model",
        "//factory/cli/src/tbhbdev/alpha/agent:transport",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:runfiles_names",
        "//factory/cli/src/tbhbdev/alpha/agent/launch/decisions:bootstrap",
    ],
)
