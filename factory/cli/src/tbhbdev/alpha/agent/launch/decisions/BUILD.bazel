load("//factory/cli:python.bzl", "cli_py_library")

filegroup(
    name = "package_files",
    srcs = glob(["*.py"]),
    visibility = ["//factory/cli:__pkg__"],
)

cli_py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = ["../../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "bootstrap",
    srcs = ["bootstrap.py"],
    extra_deps = [
        ":__init__",
        "//factory/cli/src/tbhbdev/alpha/agent/launch:__init__",
    ],
    imports = ["../../../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        "//factory/cli/src/tbhbdev/alpha/agent:model",
        "//factory/cli/src/tbhbdev/alpha/agent/decisions:remote_shell",
    ],
)
