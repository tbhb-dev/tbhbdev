load("//factory/cli:python.bzl", "cli_py_library")

cli_py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = ["../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":config",
        "//factory/cli/src/tbhbdev:userconfig",
    ],
)

cli_py_library(
    name = "config",
    srcs = ["config.py"],
    imports = ["../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":rules",
        "//factory/cli/src/tbhbdev:userconfig",
    ],
)

cli_py_library(
    name = "events",
    srcs = ["events.py"],
    imports = ["../../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "rules",
    srcs = ["rules.py"],
    imports = ["../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [":state"],
)

cli_py_library(
    name = "runner",
    srcs = ["runner.py"],
    imports = ["../../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":config",
        ":rules",
        ":scoring",
        ":state",
        ":store",
    ],
)

cli_py_library(
    name = "scoring",
    srcs = ["scoring.py"],
    imports = ["../../.."],
    pyi_deps = [":runner"],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":rules",
        ":store",
    ],
)

cli_py_library(
    name = "state",
    srcs = ["state.py"],
    imports = ["../../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "store",
    srcs = ["store.py"],
    imports = ["../../.."],
    pyi_deps = [":rules"],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [":events"],
)

filegroup(
    name = "package_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//factory/cli:__pkg__"],
)
