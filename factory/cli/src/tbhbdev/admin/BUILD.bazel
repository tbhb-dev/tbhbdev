load("@rules_python//python:defs.bzl", "py_binary")
load("//factory/cli:python.bzl", "cli_py_library")

cli_py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":audit",
        ":policy",
        ":request",
        "//factory/cli/src/tbhbdev/alpha:gh_app",
    ],
)

cli_py_library(
    name = "audit",
    srcs = ["audit.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [":policy"],
)

py_binary(
    name = "audit_receiver",
    srcs = ["audit_receiver.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "policy",
    srcs = ["policy.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
)

cli_py_library(
    name = "request",
    srcs = ["request.py"],
    imports = ["../.."],
    visibility = ["//factory/cli:__subpackages__"],
    deps = [
        ":audit",
        ":policy",
        "//factory/cli/src/tbhbdev:secrets",
        "//factory/cli/src/tbhbdev/alpha:gh_app",
        "@cli_pip//httpx",
    ],
)

filegroup(
    name = "package_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//factory/cli:__pkg__"],
)
