load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("//factory:go.bzl", "go_test")

repo_files(visibility = ["//factory/github-metrics:__subpackages__"])

go_library(
    name = "github-metrics_lib",
    srcs = [
        "main.go",
        "reconciler.go",
    ],
    importpath = "github.com/tbhb-dev/tbhbdev/factory/github-metrics/cmd/github-metrics",
    visibility = ["//factory/github-metrics:__pkg__"],
    deps = [
        "//factory/github-metrics/internal/appauth",
        "//factory/github-metrics/internal/budget",
        "//factory/github-metrics/internal/ghclient",
        "//factory/github-metrics/internal/receiver",
        "//factory/github-metrics/internal/reconcile",
        "//factory/github-metrics/internal/recorder",
        "//factory/github-metrics/internal/store",
        "//factory/github-metrics/internal/telemetry",
        "//factory/github-metrics/internal/worker",
        "@io_opentelemetry_go_otel_metric//:metric",
    ],
)

go_binary(
    name = "github-metrics",
    embed = [":github-metrics_lib"],
    visibility = ["//factory/github-metrics:__subpackages__"],
)

go_test(
    name = "github-metrics_test",
    srcs = ["main_test.go"],
    embed = [":github-metrics_lib"],
    visibility = ["//factory/github-metrics:__pkg__"],
    deps = [
        "//factory/github-metrics/internal/recorder",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata",
    ],
)
