load("@tbhb_rules//format:defs.bzl", "format_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("@tbhb_rules_go//:defs.bzl", "go_arch_lint_test", "go_deadcode_test", "go_mod_tidy_test", "gomutants_test", "govulncheck", "govulncheck_test")
load(":go_lint.bzl", "golangci_lint_test")

# gazelle:go_visibility //factory/github-metrics:__subpackages__
# gazelle:map_kind go_test go_test //factory:go.bzl

package(default_visibility = ["//factory:__subpackages__"])

repo_files(visibility = ["//factory/github-metrics:__subpackages__"])

# Keep test-only packages in the scope alongside the service entry point.
GO_TARGETS = [
    "//factory/github-metrics/cmd/github-metrics:github-metrics",
    "//factory/github-metrics/cmd/github-metrics:github-metrics_test",
    "//factory/github-metrics/internal/appauth:appauth_test",
    "//factory/github-metrics/internal/backfill:backfill_test",
    "//factory/github-metrics/internal/budget:budget_test",
    "//factory/github-metrics/internal/ghclient:ghclient_test",
    "//factory/github-metrics/internal/receiver:receiver_test",
    "//factory/github-metrics/internal/reconcile:reconcile_test",
    "//factory/github-metrics/internal/recorder:recorder_test",
    "//factory/github-metrics/internal/review:review_test",
    "//factory/github-metrics/internal/store:store_test",
    "//factory/github-metrics/internal/telemetry:telemetry_test",
    "//factory/github-metrics/internal/version:version_test",
    "//factory/github-metrics/internal/worker:worker_test",
]

golangci_lint_test(
    name = "golangci_lint_test",
    srcs = GO_TARGETS,
    expect_linted = [":repo_files"],
)

go_arch_lint_test(
    name = "go_arch_lint_test",
    size = "small",
    srcs = GO_TARGETS,
    config = ":.go-arch-lint.yml",
    go_mod = ":go.mod",
)

go_deadcode_test(
    name = "go_deadcode_test",
    srcs = GO_TARGETS,
)

go_mod_tidy_test(
    name = "go_mod_tidy_test",
    srcs = [":repo_files"],
    go_mod = ":go.mod",
    go_sum = ":go.sum",
    proxy = "@github_metrics_go_mod_proxy//:proxy",
)

govulncheck(
    name = "govulncheck",
    srcs = GO_TARGETS,
    data = ["//factory/github-metrics/internal/reconcile:testdata/ci_jobs.json"],
    go_mod = ":go.mod",
    go_sum = ":go.sum",
    proxy = "@github_metrics_go_mod_proxy//:proxy",
)

# The shared rule tags this test manual. CI runs both targets explicitly.
govulncheck_test(
    name = "govulncheck_test",
    srcs = GO_TARGETS,
    data = ["//factory/github-metrics/internal/reconcile:testdata/ci_jobs.json"],
    go_mod = ":go.mod",
    go_sum = ":go.sum",
    proxy = "@github_metrics_go_mod_proxy//:proxy",
)

# Run by hand; the scheduled run uses store_mutation_nightly_test.
gomutants_test(
    name = "store_mutation_test",
    advisory = True,
    cpus = 4,
    go_mod = ":go.mod",
    go_sum = ":go.sum",
    proxy = "@github_metrics_go_mod_proxy//:proxy",
    tags = ["manual"],
    tests = [
        "//factory/github-metrics/internal/store:store_test",
        "//factory/github-metrics/internal/worker:worker_test",
    ],
)

# The scheduled Linux run reports survivors without failing and always checks
# the full scope. Making it blocking waits until survivors are zero or the rule
# can exclude them. The manual tag keeps this report out of wildcard PR runs.
# Known survivors:
# internal/store/store.go:235:16 BRANCH_IF: equivalent; NextSequence cannot fail
# after earlier writes succeed.
# internal/store/store.go:259:10 RETURN_ZERO: equivalent; entries is already a nil slice.
# internal/store/store.go:236:10 RETURN_ERROR_NIL: not covered; needs dependency fault injection.
# internal/store/store.go:236:37 ERRORF_WRAP: not covered; same fault injection path.
gomutants_test(
    name = "store_mutation_nightly_test",
    advisory = True,
    cpus = 4,
    go_mod = ":go.mod",
    go_sum = ":go.sum",
    mutation_oses = ["linux"],
    proxy = "@github_metrics_go_mod_proxy//:proxy",
    require_scope = "full",
    tags = ["manual"],
    tests = [
        "//factory/github-metrics/internal/store:store_test",
        "//factory/github-metrics/internal/worker:worker_test",
    ],
)

format_test(
    name = "go_format_test",
    srcs = [
        ":.golangci.yml",
        ":go.mod",
        ":repo_files",
    ],
    formatters = ["@tbhb_rules_go//:golangci_fmt"],
    strip_prefix = "factory/github-metrics",
)
