go_test(
    name = "ghclient_test",
    srcs = [
        "fuzz_internal_test.go",
        "ghclient_test.go",
        "limit_test.go",
        "synctest_test.go",
    ],
    embed = [":ghclient"],
    visibility = ["//factory/github-metrics:__pkg__"],
    deps = [
        "//factory/github-metrics/internal/budget",
    ],
