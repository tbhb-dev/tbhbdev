load("@rules_go//go:def.bzl", "go_library")
load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("//factory:go.bzl", "go_test")

repo_files(visibility = ["//factory/github-metrics:__subpackages__"])

go_library(
    name = "receiver",
    srcs = [
        "receiver.go",
        "server.go",
    ],
    importpath = "github.com/tbhb-dev/tbhbdev/factory/github-metrics/internal/receiver",
    visibility = ["//factory/github-metrics:__subpackages__"],
    deps = ["//factory/github-metrics/internal/store"],
)

go_test(
    name = "receiver_test",
    srcs = [
        "fuzz_internal_test.go",
        "receiver_test.go",
        "reject_busy_internal_test.go",
        "server_test.go",
    ],
    embed = [":receiver"],
    visibility = ["//factory/github-metrics:__pkg__"],
    deps = ["//factory/github-metrics/internal/store"],
)
