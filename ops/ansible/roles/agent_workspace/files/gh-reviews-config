#!/usr/bin/env bash
# Write a gh config dir that authenticates as the GitHub App tbhb-dev-reviews,
# so review agents post comments and reviews as the app instead of tbhb-agent.
#
# Usage: gh-reviews-config <dir> <owner/repo>
#
# Reads the app ID and private key from the managed credentials cache
# (~/.local/state/gh-reviews/credentials.json, mode 600). Set GH_REVIEWS_CACHE
# to override the path. Signs a JWT, finds the app's installation for <owner/repo>,
# and writes the installation token (valid about an hour) to <dir>/hosts.yml for
# github.com. Use it with GH_CONFIG_DIR=<dir>. Never prints the token, key or
# JWT. Exits nonzero with a short message on failure.
# shellcheck disable=SC2312
set -euo pipefail
user='tbhb-dev-agent-reviews[bot]'
cache=${GH_REVIEWS_CACHE:-$HOME/.local/state/gh-reviews/credentials.json}
api=https://api.github.com
die() {
	echo "gh-reviews-config: $*" >&2
	exit 1
}
[[ $# -eq 2 ]] || {
	echo "usage: gh-reviews-config <dir> <owner/repo>" >&2
	exit 2
}
out=$1 repo=$2
[[ $repo =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || die "bad repo '$repo': use owner/repo"
owner=${repo%%/*}
for c in jq curl openssl; do command -v "$c" >/dev/null 2>&1 || die "$c not found on PATH"; done

umask 077
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
body=$work/body.json

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# call METHOD PATH: response body to $body; the JWT reaches curl on stdin, never argv.
call() {
	local status
	status=$({
		printf 'header = "Authorization: Bearer '
		cat "$work/jwt"
		printf '"\n'
	} |
		curl -sS -X "$1" -o "$body" -w '%{http_code}' -H 'Accept: application/vnd.github+json' \
			-H 'X-GitHub-Api-Version: 2022-11-28' -K - "$api$2") || return 1
	[[ $status -lt 400 ]]
}

[[ -s $cache ]] || die "credentials cache is missing or empty: $cache"
app_id=$(jq -er '.app_id | tostring' "$cache" 2>/dev/null) || die "cache has no app_id"
pem=$(jq -er '.private_key' "$cache" 2>/dev/null) || die "cache has no private_key"

printf '%s\n' "$pem" | openssl pkey -noout 2>/dev/null || die "private_key does not parse"
now=$(date +%s)
claims=$(jq -nc --argjson iat $((now - 60)) --argjson exp $((now + 540)) --arg iss "$app_id" '{iat:$iat, exp:$exp, iss:$iss}')
unsigned="$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | b64url).$(printf '%s' "$claims" | b64url)"
signature=$(printf '%s' "$unsigned" | openssl dgst -sha256 -sign <(printf '%s\n' "$pem") | b64url) || die "could not sign the app JWT"
printf '%s.%s' "$unsigned" "$signature" >"$work/jwt"
if call GET "/repos/$repo/installation" || call GET "/orgs/$owner/installation"; then
	inst=$(jq -r '.id // empty' "$body")
else
	die "app $app_id has no installation for $repo or $owner"
fi
[[ -n $inst ]] || die "no installation id for $repo"
call POST "/app/installations/$inst/access_tokens" || die "minting an installation token failed: $(jq -r '.message // "no message"' "$body" 2>/dev/null)"
jq -e '.token | strings' "$body" >/dev/null || die "no token in the access_tokens response"

mkdir -p "$out"
chmod 700 "$out"
# gh's hosts.yml layout; the token goes from the response file straight into it.
jq -r --arg u "$user" '"github.com:\n    users:\n        \"\($u)\":\n            oauth_token: \(.token)\n    git_protocol: https\n    oauth_token: \(.token)\n    user: \"\($u)\"\n"' "$body" >"$out/.hosts.yml.$$"
chmod 600 "$out/.hosts.yml.$$"
mv -f "$out/.hosts.yml.$$" "$out/hosts.yml"
