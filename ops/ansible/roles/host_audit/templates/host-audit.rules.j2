## {{ ansible_managed }}
## The lab nodes' audit rules, from the host_audit role.

-b 8192
-f 1

## Identity and privilege
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config.d/ -p wa -k sshd
-w /etc/pam.d/ -p wa -k pam
-w /etc/security/ -p wa -k pam
## One line per run of these tools. docker is left out: the agent runs it constantly.
-w /usr/bin/sudo -p x -k agent_tools
-w /usr/bin/su -p x -k agent_tools
-w /usr/bin/ssh -p x -k agent_tools
-w /usr/bin/virsh -p x -k agent_tools
-w /usr/bin/nsenter -p x -k agent_tools
## A setuid or setgid exec that gains root: sudo, su and the rest.
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k priv_esc
-a always,exit -F arch=b32 -S execve -C uid!=euid -F euid=0 -k priv_esc
-a always,exit -F arch=b64 -S execve -C gid!=egid -F egid=0 -k priv_esc
-a always,exit -F arch=b32 -S execve -C gid!=egid -F egid=0 -k priv_esc

## Persistence
-w /etc/systemd/ -p wa -k persistence
-w /etc/crontab -p wa -k persistence
-w /etc/cron.d/ -p wa -k persistence
-w /etc/cron.hourly/ -p wa -k persistence
-w /etc/cron.daily/ -p wa -k persistence
-w /etc/cron.weekly/ -p wa -k persistence
-w /etc/cron.monthly/ -p wa -k persistence
-w /var/spool/cron/ -p wa -k persistence
-w /etc/netplan/ -p wa -k persistence
-w /etc/nftables.conf -p wa -k persistence
-w /usr/lib/systemd/system/ -p wa -k persistence
-w /etc/ld.so.preload -p wa -k persistence
-w /etc/profile.d/ -p wa -k persistence
-w /etc/modprobe.d/ -p wa -k persistence
-w /etc/sysctl.d/ -p wa -k persistence
-w {{ ["/etc/rc", "local"] | join(".") }} -p wa -k persistence
-w /etc/apparmor.d/ -p wa -k persistence
{% for dir in host_audit_ssh_present %}
-w {{ dir }}/ -p wa -k ssh_keys
{% endfor %}

## Kernel, boot and clock
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b64 -S kexec_load,kexec_file_load -k kexec
## The i386 syscall table names this call sys_kexec_load, so the name fails to load; use the number.
-a always,exit -F arch=b32 -S 283 -k kexec
## Logged-in users only: daemons, with auid unset, mount and adjust the clock all the time.
-a always,exit -F arch=b64 -S mount,umount2 -F auid!=unset -k mounts
-a always,exit -F arch=b32 -S mount,umount2 -F auid!=unset -k mounts
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -F auid!=unset -k time
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -F auid!=unset -k time
-w /etc/localtime -p wa -k time

## Container and VM control
-w /etc/docker/ -p wa -k containers
-w /etc/libvirt/ -p wa -k containers

## The audit setup itself. The rules aren't locked, so a change to them leaves a record.
-w /etc/audit/ -p wa -k audit_config
-w /usr/sbin/auditctl -p x -k audit_config
-w /usr/sbin/augenrules -p x -k audit_config

## Every command an operator account runs
{% for user in host_audit_command_present %}
-a always,exit -F arch=b64 -S execve -F auid={{ ansible_facts.getent_passwd[user][1] }} -k ops_cmd
-a always,exit -F arch=b32 -S execve -F auid={{ ansible_facts.getent_passwd[user][1] }} -k ops_cmd
{% endfor %}
