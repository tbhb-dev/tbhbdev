{% for name, value in (lookup('ansible.builtin.template', 'environment.json.j2') | from_json).items() %}
{{ name }}={{ value | to_json }}
{% endfor %}
O11Y_ALERT_SMTP_ENABLED=true
O11Y_ALERT_SMTP_SKIP_VERIFY=false
O11Y_S3_ENV_FILE={{ (o11y_data_dir ~ '/secrets/s3.env') | to_json }}
{% for config in o11y_configs.files | sort(attribute='path') %}
O11Y_CONFIG_{{ (config.path | basename).split('-')[0] | upper }}={{ (o11y_root ~ '/releases/' ~ o11y_release_id ~ '/config/' ~ (config.path | basename)) | to_json }}
{% endfor %}
