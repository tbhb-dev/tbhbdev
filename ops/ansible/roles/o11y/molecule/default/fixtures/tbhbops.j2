#!/usr/bin/env python3
"""Render the real configuration, then substitute small HTTP services."""

import os
import subprocess  # nosec B404
import sys
from pathlib import Path

import yaml

# Forward the render arguments to the local tool without a shell.
subprocess.run(  # noqa: S603  # nosec B603, B607
    ["{{ playbook_dir }}/../../../../../.venv/bin/tbhbops", *sys.argv[1:]],  # noqa: S607 - absolute after templating
    check=True,
)
output = Path(sys.argv[sys.argv.index("--out") + 1]) / "release" / "compose.yaml"
server = """
import os
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(
            503 if Path('/tmp/unhealthy').exists() else int(os.environ['STATUS'])
        )
        self.end_headers()
    do_HEAD = do_GET
    def log_message(self, *args):
        pass
HTTPServer(('0.0.0.0', int(os.environ['PORT'])), Handler).serve_forever()
"""
services = {}
for name, port in {
    "grafana": 3000,
    "rustfs": 9000,
    "loki": 3100,
    "tempo": 3200,
    "mimir": 8080,
    "alloy": 12345,
}.items():
    services[name] = {
        "image": "python:3.14-alpine",
        "network_mode": "bridge",
        "command": ["python", "-c", server],
        "environment": {
            "PORT": str(port),
            "STATUS": "503"
            if name == "grafana"
            and os.environ["O11Y_GRAFANA_ROOT_URL"].endswith("/fail/")
            else "200",
        },
        "healthcheck": {
            "test": [
                "CMD",
                "python",
                "-c",
                f"import urllib.request; urllib.request.urlopen('http://127.0.0.1:{port}/')",
            ],
            "interval": "1s",
            "timeout": "1s",
            "retries": 2,
        },
    }
if os.environ["O11Y_GRAFANA_ROOT_URL"].endswith(("/probe/", "/fail/")):
    del services["grafana"]["healthcheck"]
services["grafana"]["ports"] = ["127.0.0.1:3000:3000"]
services["alloy"]["ports"] = ["127.0.0.1:4317:4317", "127.0.0.1:4318:4318"]
output.write_text(yaml.safe_dump({"name": "o11y", "services": services}))
