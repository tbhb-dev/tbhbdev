load("@rules_python//python:defs.bzl", "py_library")
load("//ops/packages:pytest.bzl", "ops_py_test")
load(":test_partition.bzl", "pytest_partition_test")

# gazelle:python_root
# gazelle:python_generation_mode package
# gazelle:python_generation_mode_per_package_require_test_entry_point false
# gazelle:map_kind py_test ops_py_test //ops/packages:pytest.bzl
# gazelle:exclude integration
# gazelle:exclude testdata
# gazelle:exclude unit
# gazelle:exclude test_*.py
# gazelle:exclude *_test.py

package(default_testonly = True)

py_library(
    name = "tests",
    srcs = [
        "__init__.py",
        "deploy_fakes.py",
        "deploy_model.py",
        "deploy_receiver.py",
        "ssh_argv.py",
    ],
    visibility = ["//ops/packages/tbhbops/tests:__subpackages__"],
    deps = [
        "//ops/packages/tbhbops/src",
        "@cli_pip//pytest",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//ops/packages/tbhbops/tests:__subpackages__"],
    deps = ["@cli_pip//hypothesis"],
)

py_library(
    name = "deploy_test_fixtures",
    # The nested conftests import fixtures from these test modules.
    srcs = glob(
        [
            "integration/**/*.py",
            "unit/**/*.py",
        ],
        exclude = [
            "**/*_test.py",
            "**/test_*.py",
        ],
    ) + [
        "test_deploy_config.py",
        "test_deploy_filesystem.py",
        "test_deploy_protocol.py",
    ],
    deps = [
        ":tests",
        "//ops/packages/tbhbops/src",
        "@cli_pip//pytest",
    ],
)

TEST_DATA = glob(["testdata/**"]) + [
    "invalid_dashboard.json",
    "//ops:deployment_fixtures",
    "//ops:o11y_fixtures",
]

TEST_DEPS = [
    ":conftest",
    ":tests",
    "//ops/packages/tbhbops/src",
    "@cli_pip//ansible_core",
    "@cli_pip//hypothesis",
    "@cli_pip//jinja2",
    "@cli_pip//pytest",
    "@cli_pip//pyyaml",
    "@cli_pip//uv",
]

DEPLOYMENT_INTEGRATION_TESTS = glob(["integration/**/test_*.py"])

ops_py_test(
    name = "deployment_integration_test",
    timeout = "moderate",
    srcs = DEPLOYMENT_INTEGRATION_TESTS,
    data = TEST_DATA,
    paths = DEPLOYMENT_INTEGRATION_TESTS,
    deps = TEST_DEPS + [":deploy_test_fixtures"],
)

DEPLOYMENT_UNIT_TESTS = glob([
    "test_deploy_*.py",
    "unit/**/test_*.py",
])

ops_py_test(
    name = "deployment_unit_test",
    timeout = "moderate",
    srcs = DEPLOYMENT_UNIT_TESTS,
    data = TEST_DATA,
    paths = DEPLOYMENT_UNIT_TESTS,
    deps = TEST_DEPS + [":deploy_test_fixtures"],
)

DSM_TESTS = glob(["test_dsm_*.py"])

ops_py_test(
    name = "dsm_test",
    timeout = "moderate",
    srcs = DSM_TESTS,
    data = TEST_DATA,
    paths = DSM_TESTS,
    deps = TEST_DEPS,
)

HOST_AND_SERVICES_TESTS = [
    "test_agent_reconverge.py",
    "test_authorized_lines.py",
    "test_bazel_server_reaper.py",
    "test_ca_backup.py",
    "test_chrony_nts.py",
    "test_connect_endpoints.py",
    "test_dns.py",
    "test_dns_smoke.py",
    "test_event_gateway_deploy.py",
    "test_first_run.py",
    "test_host_hardening.py",
    "test_inventory_ssh.py",
    "test_launchers.py",
    "test_mac_snapshot_thin.py",
    "test_op_connect.py",
    "test_runner_pool_egress.py",
    "test_rustfs_probe.py",
    "test_s3_compose.py",
    "test_s3_store.py",
    "test_tailnet_addresses.py",
    "test_tailnet_policy.py",
    "test_windows_ops_admin_key.py",
    "test_windows_update_policy.py",
]

ops_py_test(
    name = "host_and_services_test",
    timeout = "moderate",
    srcs = HOST_AND_SERVICES_TESTS,
    data = TEST_DATA,
    paths = HOST_AND_SERVICES_TESTS,
    deps = TEST_DEPS,
)

OBSERVABILITY_TESTS = glob([
    "test_grafana_*.py",
    "test_o11y*.py",
]) + [
    "test_host_telemetry.py",
    "test_receipt.py",
]

ops_py_test(
    name = "observability_test",
    timeout = "moderate",
    srcs = OBSERVABILITY_TESTS,
    data = TEST_DATA + ["@promtool_test_tool//:promtool"],
    env = {"TBHB_PROMTOOL": "$(rlocationpath @promtool_test_tool//:promtool)"},
    paths = OBSERVABILITY_TESTS,
    deps = TEST_DEPS,
)

# Check the sources and pytest arguments of the targets above.
pytest_partition_test(name = "pytest_partition_test")
