load("@rules_python//python:defs.bzl", "py_library")
load("//ops/packages:pytest.bzl", "ops_py_test")

# gazelle:python_root
# gazelle:python_generation_mode package
# gazelle:python_generation_mode_per_package_require_test_entry_point false
# gazelle:map_kind py_test ops_py_test //ops/packages:pytest.bzl
# gazelle:exclude testdata
# gazelle:exclude unit

package(default_testonly = True)

py_library(
    name = "tests",
    srcs = [
        "__init__.py",
        "deploy_fakes.py",
        "deploy_model.py",
        "ssh_argv.py",
    ],
    visibility = ["//ops/packages/tbhbops/tests:__subpackages__"],
    deps = [
        "//ops/packages/tbhbops/src",
        "@cli_pip//pytest",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//ops/packages/tbhbops/tests:__subpackages__"],
    deps = ["@cli_pip//hypothesis"],
)

ops_py_test(
    name = "tests_test",
    timeout = "long",
    srcs = glob(
        [
            "*_test.py",
            "test_*.py",
            "unit/**/*.py",
        ],
        allow_empty = True,
    ),  # keep
    data = glob(["testdata/**"]) + [
        "invalid_dashboard.json",
        "//ops:deployment_fixtures",
        "//ops:o11y_fixtures",
        "@promtool_test_tool//:promtool",
    ],
    env = {"TBHB_PROMTOOL": "$(rlocationpath @promtool_test_tool//:promtool)"},
    deps = [
        ":conftest",
        ":tests",
        "//ops/packages/tbhbops/src",
        "@cli_pip//ansible_core",
        "@cli_pip//hypothesis",
        "@cli_pip//jinja2",
        "@cli_pip//pytest",
        "@cli_pip//pyyaml",
        "@cli_pip//uv",
    ],
)
